<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/default_layout">

    <com.google.android.material.tabs.TabLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/tab_layout"
        android:background="#fff">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="지도" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="속도계" />
    </com.google.android.material.tabs.TabLayout>

    <LinearLayout
        android:id="@+id/map_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RelativeLayout
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_alignParentBottom="true"
            android:layout_weight="0" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="20dp">

        <GridLayout
            android:id="@+id/speed_pre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:gravity="center"
            android:orientation="horizontal"
            android:verticalSpacing="30dp"
            tools:ignore="MissingConstraints">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="시간"
                    android:textColor="#000"
                    android:textSize="25dp" />

                <TextView
                    android:id="@+id/m_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0:0:0"
                    android:textColor="#000"
                    android:textSize="20dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="50dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:text="현재속도"
                    android:textColor="#000"
                    android:textSize="25dp" />

                <TextView
                    android:id="@+id/m_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:text="0.0Km/h"
                    android:textColor="#000"
                    android:textSize="25dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="50dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="거리"
                    android:textColor="#000"
                    android:textSize="25dp" />

                <TextView
                    android:id="@+id/m_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0m"
                    android:textColor="#000"
                    android:textSize="25dp" />
            </LinearLayout>
        </GridLayout>
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/speed_tap"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/subactivity_shape"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="시간"
                android:textColor="#3e7319"
                android:textSize="25dp"
                android:textStyle="bold"
                tools:ignore="MissingConstraints" />

            <TextView
                android:id="@+id/ingtime"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="00:00:00"
                android:textColor="#000"
                android:textSize="20dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="380dp"
            android:layout_height="150dp"
            android:id="@+id/speedlayout"
            android:orientation="vertical"
            android:background="@drawable/subactivity_shape"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:padding="10dp">

            <GridLayout
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:verticalSpacing="30dp"
                tools:ignore="MissingConstraints">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="left"
                        android:text="평균"
                        android:textSize="25dp"
                        android:textColor="#3e7319"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/avgspeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="left"
                        android:text="0"
                        android:layout_marginTop="10dp"
                        android:textColor="#000"
                        android:textSize="20dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="100dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:text="속도"
                        android:textSize="25dp"
                        android:textColor="#3e7319"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/nowspeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="0.0"
                        android:textSize="40dp"
                        android:textColor="#000"
                        android:textStyle="bold"
                        tools:ignore="MissingConstraints" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:text="km/h"
                        android:textColor="#000"
                        android:textSize="17dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="100dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="right"
                        android:text="최고"
                        android:textSize="25dp"
                        android:textColor="#3e7319"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/maxspeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="right"
                        android:layout_marginTop="10dp"
                        android:text="0"
                        android:textSize="20dp"
                        android:textColor="#000"
                        tools:ignore="DuplicateIds" />
                </LinearLayout>
            </GridLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/subactivity_shape"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:text="휴식시간"
                android:textSize="25dp"
                android:textColor="#3e7319"
                android:textStyle="bold"
                tools:ignore="MissingConstraints" />

            <TextView
                android:id="@+id/resttime"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="00:00:00"
                android:textColor="#000"
                android:textSize="20dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/subactivity_shape"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:padding="10dp">

            <GridLayout
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:verticalSpacing="30dp"
                tools:ignore="MissingConstraints">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="left"
                        android:text="고도"
                        android:textSize="25dp"
                        android:textColor="#3e7319"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/Nowgodo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="left"
                        android:text="0"
                        android:textColor="#000"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="100dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:text="거리"
                        android:textSize="25dp"
                        android:textColor="#3e7319"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/dis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:text="0"
                        android:textColor="#000"
                        android:textSize="20dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="60dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="right"
                        android:text="획득고도"
                        android:textSize="25dp"
                        android:textColor="#3e7319"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/getgodo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="right"
                        android:text="0"
                        android:textColor="#000"
                        android:textSize="20dp" />
                </LinearLayout>
            </GridLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">




            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >






            </LinearLayout>
        </LinearLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/status_layout">
            <TextView
                android:id="@+id/m_t"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right"
                android:text="00"
                android:layout_marginRight="10dp"
                android:textSize="20dp" />
            <TextView
                android:id="@+id/m_rest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right"
                android:text="00"
                android:layout_marginRight="10dp"
                android:textSize="20dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/flow_info"
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/subactivity_shape"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:padding="10dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="경쟁전 이름"
                android:textSize="25dp"
                android:textColor="#3e7319"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/couse_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="-10dp"
                android:gravity="center"
                android:text="코스이름"
                android:textColor="#000"
                android:textSize="20dp" />

            <TextView
                android:id="@+id/course_follow_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="코스 준비 중"
                android:textColor="#365B3D"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/course_follow_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="진행률 - · 남은 거리 -"
                android:textColor="#666666"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>


    <GridLayout
        android:verticalSpacing="30dp"
        android:layout_marginTop="30dp"
        android:layout_gravity = "center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="2"
        android:orientation="vertical"
        tools:ignore="MissingConstraints">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/endriding"
                android:layout_width="52dp"
                android:layout_height="50dp"
                android:background="@drawable/end_bt"
                tools:ignore="MissingConstraints" />
            <Button
                android:id="@+id/pausebt"
                android:layout_width="52dp"
                android:layout_height="50dp"
                android:background="@drawable/stop_bt"
                tools:ignore="MissingConstraints"
                android:onClick="myOnClick"
                android:layout_marginLeft="50dp"/>

            <Button
                android:id="@+id/resume_bt"
                android:layout_width="52dp"
                android:layout_height="50dp"
                android:background="@drawable/restart_icon"
                tools:ignore="MissingConstraints"
                android:onClick="myOnClick"
                android:layout_marginLeft="50dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">


            <Button
                android:id="@+id/sos_sound"
                android:layout_width="50dp"
                android:layout_height="55dp"
                android:background="@drawable/sos_sound"
                android:contentDescription="긴급 경보음"
                tools:ignore="MissingConstraints" />

            <Spinner
                android:id="@+id/help"
                android:layout_width="50dp"
                android:layout_height="55dp"
                android:background="@drawable/help"
                android:contentDescription="긴급 도움 요청"
                android:layout_marginLeft="50dp"
                android:spinnerMode="dialog"
                android:layout_weight="1" />
        </LinearLayout>

    </GridLayout>
</LinearLayout>
