<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.bike.trailgo.ui.home.HomeFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_nav_home_to_nav_course_scrap"
            app:destination="@id/nav_course_scrap" />
        <action
            android:id="@+id/action_nav_home_to_nav_course_view"
            app:destination="@id/nav_course_view" />
        <action
            android:id="@+id/action_nav_home_to_nav_records"
            app:destination="@id/nav_records" />
        <action
            android:id="@+id/action_nav_home_to_myDetailFragment"
            app:destination="@id/myDetailFragment" />
        <action
            android:id="@+id/action_nav_home_to_nav_course_search"
            app:destination="@id/nav_course_search" />
        <action
            android:id="@+id/action_nav_home_to_nav_competition_view"
            app:destination="@id/nav_competition_view" />
        <action
            android:id="@+id/action_nav_home_to_nav_mission_view"
            app:destination="@id/nav_mission_view" />
        <action
            android:id="@+id/action_nav_home_to_nav_danger_view"
            app:destination="@id/nav_danger_view" />
        <action
            android:id="@+id/action_nav_home_to_setting"
            app:destination="@id/setting" />
    </fragment>

    <fragment
        android:id="@+id/nav_records"
        android:name="com.bike.trailgo.ui.records.RecordFragment"
        android:label="@string/menu_records"
        tools:layout="@layout/fragment_records" >
        <action
            android:id="@+id/action_nav_records_to_myDetailFragment"
            app:destination="@id/myDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/nav_course_view"
        android:name="com.bike.trailgo.ui.courses.CourseViewFragment"
        android:label="코스 보기"
        tools:layout="@layout/fragment_course_view" >
        <action
            android:id="@+id/action_nav_course_view_to_nav_course_detail"
            app:destination="@id/nav_course_detail" />
    </fragment>
    <fragment
        android:id="@+id/nav_course_scrap"
        android:name="com.bike.trailgo.ui.courses.CourseScrapFragment"
        android:label="@string/menu_course_scrap"
        tools:layout="@layout/fragment_course_scrap" />

    <fragment
        android:id="@+id/nav_course_search"
        android:name="com.bike.trailgo.ui.courses.CourseSearchFragment"
        android:label="코스 찾기"
        tools:layout="@layout/fragment_course_search" />
    <fragment
        android:id="@+id/nav_course_detail"
        android:name="com.bike.trailgo.ui.courses.CourseDetailFragment"
        android:label=""
        tools:layout="@layout/fragment_course_detail" />

    <fragment
        android:id="@+id/myDetailFragment"
        android:name="com.bike.trailgo.ui.records.MyDetailFragment"
        android:label="내 기록"
        tools:layout="@layout/fragment_my_detail" />

    <fragment
        android:id="@+id/nav_competition_view"
        android:name="com.bike.trailgo.ui.competitions.CompetitionViewFragment"
        android:label="경쟁전"
        tools:layout="@layout/fragment_competition_view" >
        <action
            android:id="@+id/action_nav_competition_view_to_competitionDetailFragment"
            app:destination="@id/competitionDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/competitionDetailFragment"
        android:name="com.bike.trailgo.ui.competitions.CompetitionDetailFragment"
        android:label="경쟁전 상세보기"
        tools:layout="@layout/fragment_competition_detail" />
    <fragment
        android:id="@+id/nav_mission_view"
        android:name="com.bike.trailgo.ui.missions.MissionViewFragment"
        android:label="미션"
        tools:layout="@layout/fragment_mission_view" >
        <action
            android:id="@+id/action_nav_mission_view_to_missionDetailFragment"
            app:destination="@id/missionDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/missionDetailFragment"
        android:name="com.bike.trailgo.ui.missions.MissionDetailFragment"
        android:label="미션 상세보기"
        tools:layout="@layout/fragment_mission_detail" />
    <fragment
        android:id="@+id/nav_danger_view"
        android:name="com.bike.trailgo.ui.dangers.DangerViewFragment"
        android:label="위험지역"
        tools:layout="@layout/fragment_danger_view" >
        <action
            android:id="@+id/action_nav_danger_view_to_dangerRegisterFragment"
            app:destination="@id/dangerRegisterFragment" />
    </fragment>
    <fragment
        android:id="@+id/dangerRegisterFragment"
        android:name="com.bike.trailgo.ui.dangers.DangerRegisterFragment"
        android:label="위험지역 등록"
        tools:layout="@layout/fragment_danger_register" />
    <fragment
        android:id="@+id/setting"
        android:name="com.bike.trailgo.setting.Setting"
        android:label="프로필 설정"
        tools:layout="@layout/fragment_profile_setting" />
    <fragment
        android:id="@+id/app_settings"
        android:name="com.bike.trailgo.setting.AppSettingsFragment"
        android:label="설정"
        tools:layout="@layout/fragment_app_settings" />

    <fragment android:id="@+id/profile_stats" android:name="com.bike.trailgo.setting.ProfileFeatureFragment" android:label="활동 통계" tools:layout="@layout/fragment_profile_feature">
        <argument android:name="screen" app:argType="string" android:defaultValue="stats" />
    </fragment>
    <fragment android:id="@+id/profile_courses" android:name="com.bike.trailgo.setting.ProfileFeatureFragment" android:label="나의 코스" tools:layout="@layout/fragment_profile_feature">
        <argument android:name="screen" app:argType="string" android:defaultValue="courses" />
    </fragment>
    <fragment android:id="@+id/profile_favorites" android:name="com.bike.trailgo.setting.ProfileFeatureFragment" android:label="즐겨찾기" tools:layout="@layout/fragment_profile_feature">
        <argument android:name="screen" app:argType="string" android:defaultValue="favorites" />
    </fragment>
    <fragment android:id="@+id/profile_badges" android:name="com.bike.trailgo.setting.ProfileFeatureFragment" android:label="배지" tools:layout="@layout/fragment_profile_feature">
        <argument android:name="screen" app:argType="string" android:defaultValue="badges" />
    </fragment>
    <fragment android:id="@+id/profile_gear" android:name="com.bike.trailgo.setting.ProfileFeatureFragment" android:label="장비 관리" tools:layout="@layout/fragment_profile_feature">
        <argument android:name="screen" app:argType="string" android:defaultValue="gear" />
    </fragment>


</navigation>
